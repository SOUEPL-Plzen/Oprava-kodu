#:import NoTransition kivy.uix.screenmanager.NoTransition
#:import Factory kivy.factory.Factory
#:set titles {"prehled": "Přehled zásob", "sklady": "Sklady", "zbozi": "Zboží", "prijem": "Příjem na sklad", "presun": "Přesun mezi sklady", "vydej": "Výdej na fakturu", "faktury": "Vystavené faktury", "dodavatel": "Dodavatel"}

<InvoicePopup@Popup>:
    title: "Faktura"
    size_hint: 0.72, 0.82
    auto_dismiss: True
    BoxLayout:
        padding: 12
        ScrollView:
            do_scroll_x: False
            Label:
                text: app.vm.detail_text
                color: 1, 1, 1, 1
                font_size: 15
                halign: "left"
                valign: "top"
                size_hint_y: None
                height: self.texture_size[1] + 16
                text_size: self.width, None

<ShellView>:
    orientation: "horizontal"
    detail_token: app.vm.detail_token
    on_detail_token: Factory.InvoicePopup().open() if self.detail_token > 0 else None
    BoxLayout:
        orientation: "vertical"
        size_hint_x: None
        width: 232
        padding: 12, 18, 12, 12
        spacing: 4
        canvas.before:
            Color:
                rgba: 0.09, 0.16, 0.27, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: "Skladová karta"
            color: 1, 1, 1, 1
            font_size: 20
            bold: True
            halign: "left"
            valign: "middle"
            size_hint_y: None
            height: 42
            text_size: self.size
        Label:
            text: "zásoby, přesuny, faktury"
            color: 0.73, 0.80, 0.88, 1
            font_size: 13
            halign: "left"
            valign: "middle"
            size_hint_y: None
            height: 28
            text_size: self.size
        Widget:
            size_hint_y: None
            height: 12
        NavButton:
            text: "Přehled"
            background_color: (1, 1, 1, 0.16) if app.vm.screen == "prehled" else (0, 0, 0, 0)
            on_release: app.vm.navigate("prehled")
        NavButton:
            text: "Sklady"
            background_color: (1, 1, 1, 0.16) if app.vm.screen == "sklady" else (0, 0, 0, 0)
            on_release: app.vm.navigate("sklady")
        NavButton:
            text: "Zboží"
            background_color: (1, 1, 1, 0.16) if app.vm.screen == "zbozi" else (0, 0, 0, 0)
            on_release: app.vm.navigate("zbozi")
        NavButton:
            text: "Příjem"
            background_color: (1, 1, 1, 0.16) if app.vm.screen == "prijem" else (0, 0, 0, 0)
            on_release: app.vm.navigate("prijem")
        NavButton:
            text: "Přesun"
            background_color: (1, 1, 1, 0.16) if app.vm.screen == "presun" else (0, 0, 0, 0)
            on_release: app.vm.navigate("presun")
        NavButton:
            text: "Výdej na fakturu"
            background_color: (1, 1, 1, 0.16) if app.vm.screen == "vydej" else (0, 0, 0, 0)
            on_release: app.vm.navigate("vydej")
        NavButton:
            text: "Faktury"
            background_color: (1, 1, 1, 0.16) if app.vm.screen == "faktury" else (0, 0, 0, 0)
            on_release: app.vm.navigate("faktury")
        NavButton:
            text: "Dodavatel"
            background_color: (1, 1, 1, 0.16) if app.vm.screen == "dodavatel" else (0, 0, 0, 0)
            on_release: app.vm.navigate("dodavatel")
        Widget:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            size_hint_y: None
            height: 64
            padding: 20, 0
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: titles[app.vm.screen] if app.vm.screen in titles else app.vm.screen
                color: 0.12, 0.16, 0.22, 1
                font_size: 22
                bold: True
                halign: "left"
                valign: "middle"
                text_size: self.size
        Label:
            text: app.vm.message
            color: (0.70, 0.16, 0.14, 1) if app.vm.message_is_error else (0.09, 0.42, 0.30, 1)
            font_size: 14
            halign: "left"
            valign: "middle"
            size_hint_y: None
            height: 32 if app.vm.message else 0
            opacity: 1 if app.vm.message else 0
            text_size: self.size
        ScreenManager:
            transition: NoTransition()
            on_kv_post: app.vm.fbind("screen", self.setter("current")); self.current = app.vm.screen
            Screen:
                name: "prehled"
                OverviewView:
            Screen:
                name: "sklady"
                WarehousesView:
            Screen:
                name: "zbozi"
                ProductsView:
            Screen:
                name: "prijem"
                ReceiptView:
            Screen:
                name: "presun"
                TransferView:
            Screen:
                name: "vydej"
                IssueView:
            Screen:
                name: "faktury"
                InvoicesView:
            Screen:
                name: "dodavatel"
                CompanyView:
